{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  automergeStrategy: 'squash',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  // the lifecycle workflow pushes updated fabric lock files to renovate branches
  gitIgnoredAuthors: [
    '41898282+github-actions[bot]@users.noreply.github.com',
  ],
  enabledManagers: [
    'gradle',
    'gradle-wrapper',
    'github-actions',
  ],
  packageRules: [
    {
      // dependency updates affect the released artifacts, so they should trigger a release
      matchManagers: [
        'gradle',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
  ],
}
