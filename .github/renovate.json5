{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  automergeStrategy: 'squash',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  // the lifecycle workflow pushes updated fabric and headlessmc-lwjgl lock files to renovate branches
  gitIgnoredAuthors: [
    '41898282+github-actions[bot]@users.noreply.github.com',
  ],
  enabledManagers: [
    'gradle',
    'gradle-wrapper',
    'github-actions',
    'dockerfile',
    'nix',
    'custom.regex',
  ],
  // the nix manager is in beta and disabled by default
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      // the headlessmc-lwjgl release the lwjgl patcher downloads, CI regenerates its lock file on renovate PRs
      customType: 'regex',
      managerFilePatterns: [
        '/headlessmc-patcher-lwjgl-patched/build\\.gradle$/',
      ],
      matchStrings: [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+def \\w+ = '(?<currentValue>[^']+)'",
      ],
    },
  ],
  packageRules: [
    {
      // dependency updates affect the released artifacts, so they should trigger a release
      matchManagers: [
        'gradle',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      // the flake only provides the dev shell, so its inputs are updated together once a month
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      schedule: [
        'on the first day of the month',
      ],
      automerge: false,
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
  ],
}
