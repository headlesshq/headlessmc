  },
  "optionalDependencies": {
    "headlessmc-linux-x64": "3.0.0-RC8",
    "headlessmc-linux-arm64": "3.0.0-RC8",
    "headlessmc-darwin-x64": "3.0.0-RC8",
    "headlessmc-darwin-arm64": "3.0.0-RC8",
    "headlessmc-win32-x64": "3.0.0-RC8"
  }
