    "headless",
    "cli",
    "fabric",
    "forge",
    "neoforge",
    "modding",
    "ci"
  ],
  "homepage": "https://headlesshq.github.io/headlessmc/",
  "bugs": "https://github.com/headlesshq/headlessmc/issues",
  "repository": {
    "type": "git",
