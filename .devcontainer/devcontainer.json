{
  "name": "headlessmc",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "additionalVersions": "21",
      "installGradle": false
    }
  },
  "mounts": [
    "source=headlessmc-gradle,target=/home/vscode/.gradle,type=volume"
  ],
  "onCreateCommand": "sudo chown vscode:vscode /home/vscode/.gradle",
  "postCreateCommand": "./gradlew --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
